# Copy this file to .env for local development and fill in real values.
# In Vercel, set these under Project Settings -> Environment Variables instead
# of committing a .env file.

# PostgreSQL connection string. Vercel Postgres / Neon / Supabase all provide
# one of these; include `?sslmode=require` if your provider needs it.
DATABASE_URL="postgresql://user:password@localhost:5432/digital_security?schema=public"

# better-auth
# Generate with: openssl rand -base64 33
BETTER_AUTH_SECRET=""
# Local dev: http://localhost:3000
# Production: your deployed URL, e.g. https://your-project.vercel.app
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials).
# The redirect URI to authorize there is: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
